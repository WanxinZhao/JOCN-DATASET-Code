# Copy this file to .env and set the secret locally. Never commit .env.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini-2024-07-18
LLM_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=3
LLM_STRICT_MODE=1
PHYSICAL_LAYER_DB_BACKEND=file
TOPOLOGY_PATH=
EQUIPMENT_PATH=
RUN_BASE_DIR=data/runs

# Optional: configure a dated price snapshot to calculate run cost.
OPENAI_PRICING_SNAPSHOT_DATE=2026-09-12
OPENAI_INPUT_USD_PER_1M_TOKENS=0.15
OPENAI_CACHED_INPUT_USD_PER_1M_TOKENS=0.075
OPENAI_OUTPUT_USD_PER_1M_TOKENS=0.60
OPENAI_PRICING_SOURCE=https://developers.openai.com/api/docs/models/gpt-4o-mini
